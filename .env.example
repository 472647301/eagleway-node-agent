# 运行环境：development、test 或 production
NODE_ENV=production

# Agent 控制 API 的监听端口，范围 1-65535
PORT=8086

# Agent 控制 API 的绑定地址；0.0.0.0 表示监听所有 IPv4 网卡
HOST=0.0.0.0

# 当前节点在中心服务中的正整数 ID，必填
NODE_ID=

# 允许访问控制 API 的来源网段，多个 CIDR 使用英文逗号分隔
ALLOWED_CIDRS=127.0.0.1/32

# 是否信任来自本机反向代理的客户端 IP 转发信息
TRUST_PROXY=false

# 中心服务的 HTTP(S) 基础地址；启用流量上报时必填
CENTER_API_URL=

# 流量上报间隔（秒），范围 10-86400
REPORT_INTERVAL_SECONDS=300

# 是否向中心服务上报流量和节点状态
REPORTING_ENABLED=true

# VPS 标称带宽（Mbps），用于上报节点带宽；生产环境必填
SERVER_BANDWIDTH_MBPS=

# 本地状态目录，用于保存 SQLite 数据库及操作暂存文件
STATE_DIR=/var/lib/eagleway-node-agent

# 本地敏感状态的加密密钥文件路径
STATE_KEY_PATH=/etc/eagleway-node-agent/state.key

# Agent 可读取的日志根目录
LOG_DIR=/var/log/eagleway-node-agent

# Xray 可执行文件路径
XRAY_BINARY=/usr/local/bin/xray

# Xray API 地址，仅允许使用 IPv4 回环地址和有效端口
XRAY_API_ADDRESS=127.0.0.1:10000

# 申请 ACME TLS 证书时使用的联系邮箱，可留空
ACME_EMAIL=

# 执行受限系统级操作的提权 helper 路径
PRIVILEGED_HELPER=/usr/local/libexec/eagleway-node-helper

# 安装、卸载等系统操作的超时时间（秒），范围 30-3600
OPERATION_TIMEOUT_SECONDS=900
