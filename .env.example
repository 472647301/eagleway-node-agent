NODE_ENV=production
PORT=8086
HOST=0.0.0.0
NODE_ID=
ALLOWED_CIDRS=127.0.0.1/32
TRUST_PROXY=false
CENTER_API_URL=
REPORT_INTERVAL_SECONDS=300
REPORTING_ENABLED=true
STATE_DIR=/var/lib/eagleway-node-agent
STATE_KEY_PATH=/etc/eagleway-node-agent/state.key
LOG_DIR=/var/log/eagleway-node-agent
TROJAN_GO_BINARY=/usr/local/bin/trojan-go
TROJAN_GO_API_ADDRESS=127.0.0.1:10000
TROJAN_GO_POLICY_PATH=/etc/eagleway-node-agent/runtime-policy.json
ACME_EMAIL=
PRIVILEGED_HELPER=/usr/local/libexec/eagleway-node-helper
OPERATION_TIMEOUT_SECONDS=900
